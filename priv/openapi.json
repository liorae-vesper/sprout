{
  "openapi": "3.1.0",
  "info": {
    "title": "Sprout Partner API",
    "version": "1.0.0",
    "description": "Field-scoped private-beta API. Provision keys through the trusted local operator portal. Send bearer keys only over HTTPS outside loopback. The portal is not a public signup or OAuth service."
  },
  "servers": [
    {
      "url": "/"
    }
  ],
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "tags": [
    {
      "name": "Fields",
      "description": "Explicitly granted farm parcels."
    },
    {
      "name": "Readings",
      "description": "Validated readings shared with the live farm dashboard."
    }
  ],
  "paths": {
    "/api/v1/fields": {
      "get": {
        "operationId": "listFields",
        "tags": [
          "Fields"
        ],
        "summary": "List granted fields",
        "description": "Requires fields:read. Returns only the explicitly granted fields.",
        "responses": {
          "200": {
            "description": "Granted fields.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/FieldList"
                }
              }
            }
          },
          "401": {
            "description": "Missing, invalid, expired, or revoked key.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "Required scope is not granted.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/fields/{field_id}/readings": {
      "parameters": [
        {
          "name": "field_id",
          "in": "path",
          "required": true,
          "description": "A field ID granted to this integration.",
          "schema": {
            "type": "integer",
            "format": "int64",
            "minimum": 1,
            "maximum": 9223372036854775807
          }
        }
      ],
      "get": {
        "operationId": "listRecentReadings",
        "tags": [
          "Readings"
        ],
        "summary": "Read recent sensor history",
        "description": "Requires readings:read and a field grant. Returns at most 24 samples oldest first. This beta endpoint is not a full-history export.",
        "responses": {
          "200": {
            "description": "Recent readings.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReadingList"
                }
              }
            }
          },
          "401": {
            "description": "Missing, invalid, expired, or revoked key.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "Required scope is not granted.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "Unknown or ungranted field.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      },
      "post": {
        "operationId": "ingestReading",
        "tags": [
          "Readings"
        ],
        "summary": "Ingest a device sample",
        "description": "Requires readings:write and a field grant. Sets source=device. Field ownership and timestamps cannot be supplied in the body.",
        "parameters": [
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": true,
            "description": "Unique per integration and sample. Retry the same field and numeric payload with the same key. Keys are retained until an explicit retention policy is introduced.",
            "schema": {
              "type": "string",
              "pattern": "^[A-Za-z0-9._:-]{8,128}$",
              "minLength": 8,
              "maxLength": 128
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Sample"
              },
              "example": {
                "moisture": 44,
                "temperature": 25,
                "humidity": 68,
                "water_l": 2
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Replay of the original saved reading.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReadingEnvelope"
                }
              }
            },
            "headers": {
              "Idempotency-Replayed": {
                "description": "Whether this is a previously committed sample.",
                "schema": {
                  "type": "boolean"
                }
              }
            }
          },
          "201": {
            "description": "New reading committed.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReadingEnvelope"
                }
              }
            },
            "headers": {
              "Idempotency-Replayed": {
                "description": "Whether this is a previously committed sample.",
                "schema": {
                  "type": "boolean"
                }
              }
            }
          },
          "400": {
            "description": "Missing/invalid idempotency key, or malformed JSON.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Missing, invalid, expired, or revoked key.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "Required scope is not granted.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "Unknown or ungranted field.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "409": {
            "description": "Idempotency key reused with different data.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "422": {
            "description": "Invalid sample.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "description": "A sprout_ key shown once at issuance. Keys expire after 90 days and can be revoked."
      }
    },
    "schemas": {
      "Sample": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "moisture",
          "temperature",
          "humidity",
          "water_l"
        ],
        "properties": {
          "moisture": {
            "type": "number",
            "minimum": 0,
            "maximum": 100,
            "description": "Soil moisture, percent."
          },
          "temperature": {
            "type": "number",
            "minimum": -50,
            "maximum": 70,
            "description": "Degrees Celsius."
          },
          "humidity": {
            "type": "number",
            "minimum": 0,
            "maximum": 100,
            "description": "Relative humidity, percent."
          },
          "water_l": {
            "type": "number",
            "minimum": 0,
            "description": "Liters consumed during this sample interval; not a cumulative meter total."
          }
        }
      },
      "Reading": {
        "type": "object",
        "required": [
          "id",
          "field_id",
          "moisture",
          "temperature",
          "humidity",
          "water_l",
          "source",
          "recorded_at"
        ],
        "properties": {
          "moisture": {
            "type": "number",
            "minimum": 0,
            "maximum": 100,
            "description": "Soil moisture, percent."
          },
          "temperature": {
            "type": "number",
            "minimum": -50,
            "maximum": 70,
            "description": "Degrees Celsius."
          },
          "humidity": {
            "type": "number",
            "minimum": 0,
            "maximum": 100,
            "description": "Relative humidity, percent."
          },
          "water_l": {
            "type": "number",
            "minimum": 0,
            "description": "Liters consumed during this sample interval; not a cumulative meter total."
          },
          "id": {
            "type": "integer",
            "format": "int64"
          },
          "field_id": {
            "type": "integer",
            "format": "int64"
          },
          "source": {
            "type": "string",
            "enum": [
              "manual",
              "simulated",
              "device"
            ]
          },
          "recorded_at": {
            "type": "string",
            "format": "date-time",
            "description": "Server ingestion timestamp."
          }
        }
      },
      "Field": {
        "type": "object",
        "required": [
          "id",
          "name",
          "area_ha",
          "boundary"
        ],
        "properties": {
          "id": {
            "type": "integer",
            "format": "int64"
          },
          "name": {
            "type": "string"
          },
          "area_ha": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "boundary": {
            "type": "object",
            "required": [
              "points"
            ],
            "properties": {
              "points": {
                "type": "array",
                "minItems": 3,
                "items": {
                  "type": "array",
                  "minItems": 2,
                  "maxItems": 2,
                  "items": {
                    "type": "number"
                  }
                },
                "description": "Unique [latitude, longitude] vertices, without repeated closing point."
              }
            }
          }
        }
      },
      "Error": {
        "type": "object",
        "required": [
          "errors"
        ],
        "properties": {
          "errors": {
            "type": "object",
            "required": [
              "detail"
            ],
            "properties": {
              "code": {
                "type": "string"
              },
              "detail": {
                "type": "string"
              },
              "fields": {
                "type": "object",
                "additionalProperties": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              }
            }
          }
        }
      },
      "ReadingEnvelope": {
        "type": "object",
        "required": [
          "data"
        ],
        "properties": {
          "data": {
            "$ref": "#/components/schemas/Reading"
          }
        }
      },
      "FieldList": {
        "type": "object",
        "required": [
          "data"
        ],
        "properties": {
          "data": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Field"
            }
          }
        }
      },
      "ReadingList": {
        "type": "object",
        "required": [
          "data",
          "meta"
        ],
        "properties": {
          "data": {
            "type": "array",
            "maxItems": 24,
            "items": {
              "$ref": "#/components/schemas/Reading"
            }
          },
          "meta": {
            "type": "object",
            "required": [
              "limit",
              "order"
            ],
            "properties": {
              "limit": {
                "const": 24
              },
              "order": {
                "const": "oldest_first"
              }
            }
          }
        }
      }
    }
  }
}
